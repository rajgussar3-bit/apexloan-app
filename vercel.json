{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/apply",
      "dest": "/apply.html"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}