{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/apply",
      "dest": "/apply.html"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "services": {
    "apexloan-backend": {
      "root": "backend",
      "entrypoint": "server.js",
      "buildCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "apexloan-backend"
      }
    }
  ]
}
